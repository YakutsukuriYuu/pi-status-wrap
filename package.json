{
  "name": "pi-status-wrap",
  "version": "0.1.0",
  "description": "Wrap Pi's footer status line instead of truncating it at the terminal width",
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package", "pi", "footer", "status", "tui"],
  "files": ["index.ts", "src", "README.md"],
  "pi": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
